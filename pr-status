#!/usr/bin/env bash
# pr-status — quick overview of PRs needing attention
# Usage: pr-status [org1,org2,...]
#   e.g. pr-status my-org
#   e.g. pr-status org-a,org-b
set -euo pipefail
CONFIG="${HOME}/.config/pr-status/config"
# Read config file
CONFIG_ORGS=""
MAX_AGE_DAYS=21
EXCLUDE_REVIEW_AUTHORS=""      # comma list; case-insensitive substring of author login
DIRECT_REVIEW_ONLY_REPOS=""    # comma list of repo or owner/repo; team-only requests hidden
TEAMMATES=()
if [ -f "$CONFIG" ]; then
  in_teammates=false
  while IFS= read -r line; do
    line="${line%%#*}"          # strip comments
    line="${line// /}"          # strip spaces
    [ -z "$line" ] && continue
    if [[ "$line" == "[teammates]" ]]; then
      in_teammates=true; continue
    elif [[ "$line" == "["* ]]; then
      in_teammates=false; continue
    fi
    if $in_teammates; then
      TEAMMATES+=("$line")
    elif [[ "$line" == orgs=* ]]; then
      CONFIG_ORGS="${line#orgs=}"
    elif [[ "$line" == max_age_days=* ]]; then
      MAX_AGE_DAYS="${line#max_age_days=}"
    elif [[ "$line" == exclude_review_authors=* ]]; then
      EXCLUDE_REVIEW_AUTHORS="${line#exclude_review_authors=}"
    elif [[ "$line" == direct_review_only_repos=* ]]; then
      DIRECT_REVIEW_ONLY_REPOS="${line#direct_review_only_repos=}"
    fi
  done < "$CONFIG"
fi
MODE="terminal"
POS_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --json) MODE="json" ;;
    *) POS_ARGS+=("$arg") ;;
  esac
done
ORGS="${POS_ARGS[0]:-$CONFIG_ORGS}"
ME="$(gh api user -q .login)"
# Colors
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
MAGENTA='\033[35m'
RESET='\033[0m'
link() {
  # OSC 8 hyperlink: \e]8;;URL\e\\TEXT\e]8;;\e\\
  printf '\e]8;;%s\e\\%s\e]8;;\e\\' "$1" "$2"
}
age_str() {
  local ts="$1"
  local now age
  now=$(date +%s)
  if command -v gdate &>/dev/null; then
    age=$(( (now - $(gdate -d "$ts" +%s)) / 3600 ))
  elif date -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s &>/dev/null 2>&1; then
    age=$(( (now - $(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s)) / 3600 ))
  elif date -d "$ts" +%s &>/dev/null 2>&1; then
    age=$(( (now - $(date -d "$ts" +%s)) / 3600 ))
  else
    echo ""; return
  fi
  if [ "$age" -lt 24 ]; then
    echo "${age}h ago"
  else
    echo "$(( age / 24 ))d ago"
  fi
}
review_icon() {
  case "$1" in
    APPROVED)           echo -e "${GREEN}✓ approved${RESET}" ;;
    CHANGES_REQUESTED)  echo -e "${RED}✕ changes${RESET}" ;;
    COMMENTED)          echo -e "${YELLOW}● commented${RESET}" ;;
    *)                  echo -e "${DIM}○ pending${RESET}" ;;
  esac
}
divider() {
  printf "${DIM}%.0s─${RESET}" {1..60}
  echo
}
ci_rollup() {
  # Print one of: success | failure | pending | none
  # CheckRun entries carry status/conclusion; StatusContext (commit status)
  # entries carry only state. A failed lookup degrades to "none".
  local repo="$1" num="$2"
  gh pr view "$num" --repo "$repo" --json statusCheckRollup 2>/dev/null | jq -r '
    (.statusCheckRollup // [])
    | if length == 0 then "none"
      elif any(.[];
          (.conclusion // "") as $c | (.state // "") as $s
          | $c == "FAILURE" or $c == "TIMED_OUT" or $c == "ACTION_REQUIRED"
            or $c == "STARTUP_FAILURE" or $c == "CANCELLED"
            or $s == "FAILURE" or $s == "ERROR") then "failure"
      elif any(.[];
          (.status // "") as $st | (.state // "") as $s
          | $st == "IN_PROGRESS" or $st == "QUEUED" or $st == "PENDING"
            or $st == "WAITING" or $st == "REQUESTED"
            or $s == "PENDING" or $s == "EXPECTED") then "pending"
      else "success" end
  ' 2>/dev/null || echo "none"
}
ci_dot() {
  case "$1" in
    success) echo -e "${GREEN}●${RESET}" ;;
    failure) echo -e "${RED}●${RESET}" ;;
    pending) echo -e "${YELLOW}●${RESET}" ;;
    *)       echo -e "${DIM}○${RESET}" ;;
  esac
}
IFS=',' read -ra ORG_LIST <<< "$ORGS"

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# A failed GitHub call must not masquerade as "nothing to show" (a rate-limited
# search would otherwise render as "All clear"). Failures are recorded here —
# from background subshells too — and abort the run at the next check_errors.
ERR_DIR="$TMPDIR/errors"; mkdir -p "$ERR_DIR"
note_error() {
  # note_error <label> <stderr-file>
  local f
  f=$(mktemp "$ERR_DIR/XXXXXX")
  printf '%s: %s\n' "$1" "$(head -n 1 "$2" 2>/dev/null | cut -c1-160)" > "$f"
}
gh_json() {
  # gh_json <outfile> <label> <gh args...> — write JSON to outfile, record failure.
  local out="$1" label="$2"; shift 2
  if ! gh "$@" > "$out" 2> "$out.err"; then
    note_error "$label" "$out.err"
    echo "[]" > "$out"
  fi
}
gh_json_teammate() {
  # Like gh_json, but a query GitHub rejects (unknown login, or a user whose
  # PRs we cannot see) only skips that teammate instead of failing the run.
  local out="$1" label="$2"; shift 2
  if ! gh "$@" > "$out" 2> "$out.err"; then
    if grep -q "Invalid search query" "$out.err"; then
      echo "pr-status: skipping — $label: GitHub rejected the search" >&2
    else
      note_error "$label" "$out.err"
    fi
    echo "[]" > "$out"
  fi
}
check_errors() {
  if compgen -G "$ERR_DIR/*" > /dev/null; then
    echo "GitHub request failed — results would be incomplete:" >&2
    cat "$ERR_DIR"/* | sort -u | head -n 4 >&2
    exit 1
  fi
}

# Compute cutoff date for team stale filter
if [ ${#TEAMMATES[@]} -gt 0 ]; then
  if command -v gdate &>/dev/null; then
    CUTOFF=$(gdate -d "-${MAX_AGE_DAYS} days" +%Y-%m-%d)
  else
    CUTOFF=$(date -v-${MAX_AGE_DAYS}d +%Y-%m-%d)
  fi
fi

# Discover teams user is member of, scoped to ORG_LIST.
# Format: [{"org": "...", "slug": "..."}]
gh_json "$TMPDIR/user_teams.json" "list teams" api /user/teams --paginate \
  --jq '[.[] | {org: .organization.login, slug: .slug}]'
check_errors
# --paginate emits one array per page; slurp and merge.
USER_TEAMS_JSON=$(jq -s 'add // []' "$TMPDIR/user_teams.json" | jq --argjson orgs "$(printf '%s\n' "${ORG_LIST[@]}" | jq -R . | jq -s .)" \
  '[.[] | select(.org as $o | $orgs | any(. == $o))]')

# ── Phase 1: fire all top-level fetches in parallel ─────
for org in "${ORG_LIST[@]}"; do
  gh_json "$TMPDIR/active_${org}.json" "search authored ($org)" \
    search prs --author="$ME" --owner="$org" --limit=100 \
    --json repository --jq '[.[].repository.nameWithOwner] | unique' &

  gh_json "$TMPDIR/review_${org}.json" "search review requests ($org)" \
    search prs --review-requested="$ME" --owner="$org" --state=open \
    --sort=updated --limit=30 \
    --json repository,number,title,author,createdAt,url &

  gh_json "$TMPDIR/mine_${org}.json" "search open PRs ($org)" \
    search prs --author="$ME" --owner="$org" --state=open \
    --sort=updated --limit=30 \
    --json repository,number,title,updatedAt,url &
done

# Team-tagged review requests: one search per (org, team) pair user belongs to.
while IFS=$'\t' read -r torg tslug; do
  [ -z "$torg" ] && continue
  safe="${torg//[^A-Za-z0-9]/_}__${tslug//[^A-Za-z0-9]/_}"
  gh_json "$TMPDIR/tagged_${safe}.json" "search team review requests (${torg}/${tslug})" \
    search prs "team-review-requested:${torg}/${tslug}" --owner="$torg" --state=open \
    --sort=updated --limit=30 \
    --json repository,number,title,author,createdAt,url &
done < <(echo "$USER_TEAMS_JSON" | jq -r '.[] | "\(.org)\t\(.slug)"')

if [ ${#TEAMMATES[@]} -gt 0 ]; then
  ti=0
  for teammate in "${TEAMMATES[@]}"; do
    for org in "${ORG_LIST[@]}"; do
      ti=$((ti+1))
      gh_json_teammate "$TMPDIR/team_$(printf '%03d' $ti).json" "search PRs by @${teammate} ($org)" \
        search prs --author="$teammate" --owner="$org" --state=open \
        --sort=updated --updated=">=${CUTOFF}" --limit=3 \
        --json repository,number,title,author,createdAt,url &
    done
  done
fi

wait
check_errors

# ── Combine phase 1 results ─────────────────────────────
ACTIVE_REPOS=$(cat "$TMPDIR"/active_*.json | jq -s 'add // [] | unique')
REVIEW_PERSONAL=$(cat "$TMPDIR"/review_*.json | jq -s 'add // []' | jq --argjson active "$ACTIVE_REPOS" '
  [.[] | select(.repository.nameWithOwner as $r | $active | any(. == $r))]')
TAGGED_RAW="[]"
if compgen -G "$TMPDIR/tagged_*.json" > /dev/null; then
  TAGGED_RAW=$(cat "$TMPDIR"/tagged_*.json | jq -s 'add // []')
fi
# Union personal + team-tagged review requests, dedupe by repo+number.
REVIEW_RAW=$(jq -n --argjson p "$REVIEW_PERSONAL" --argjson t "$TAGGED_RAW" '
  ($p + $t) | unique_by("\(.repository.nameWithOwner)#\(.number)")')
# Drop review requests from excluded authors (e.g. dependency bots).
REVIEW_RAW=$(echo "$REVIEW_RAW" | jq --arg ex "$EXCLUDE_REVIEW_AUTHORS" '
  ($ex | ascii_downcase | split(",") | map(select(length > 0))) as $pats
  | [.[] | select((.author.login // "" | ascii_downcase) as $a
               | $pats | any(. as $p | $a | contains($p)) | not)]')
MY_JSON=$(cat "$TMPDIR"/mine_*.json | jq -s 'add // []')
TEAM_RAW="[]"
if compgen -G "$TMPDIR/team_*.json" > /dev/null; then
  TEAM_RAW=$(cat "$TMPDIR"/team_*.json | jq -s 'add // []')
fi

# ── Filter out archived repos ───────────────────────────
ARCH_DIR="$TMPDIR/archived"; mkdir -p "$ARCH_DIR"
UNIQUE_REPOS=$(jq -s -n \
  --argjson r "$REVIEW_RAW" --argjson m "$MY_JSON" --argjson t "$TEAM_RAW" \
  '[$r[], $m[], $t[]] | map(.repository.nameWithOwner) | unique | .[]' -r)
ai=0
while IFS= read -r repo; do
  [ -z "$repo" ] && continue
  ai=$((ai+1))
  AIDX=$(printf '%03d' "$ai")
  (
    archived=$(gh api "repos/$repo" --jq '.archived' 2>/dev/null || echo "false")
    if [ "$archived" = "true" ]; then
      printf '%s\n' "$repo" > "$ARCH_DIR/$AIDX.txt"
    fi
  ) &
done <<< "$UNIQUE_REPOS"
wait

ARCHIVED_REPOS="[]"
if compgen -G "$ARCH_DIR/*.txt" > /dev/null; then
  ARCHIVED_REPOS=$(cat "$ARCH_DIR"/*.txt | jq -R -s 'split("\n") | map(select(length > 0))')
fi

REVIEW_RAW=$(echo "$REVIEW_RAW" | jq --argjson arch "$ARCHIVED_REPOS" \
  '[.[] | select(.repository.nameWithOwner as $r | $arch | any(. == $r) | not)]')
MY_JSON=$(echo "$MY_JSON" | jq --argjson arch "$ARCHIVED_REPOS" \
  '[.[] | select(.repository.nameWithOwner as $r | $arch | any(. == $r) | not)]')
TEAM_RAW=$(echo "$TEAM_RAW" | jq --argjson arch "$ARCHIVED_REPOS" \
  '[.[] | select(.repository.nameWithOwner as $r | $arch | any(. == $r) | not)]')

# ── Phase 2: secondary per-PR fetches in parallel ───────
DIRECT_DIR="$TMPDIR/direct"; mkdir -p "$DIRECT_DIR"
ri=0
while IFS=$'\t' read -r full_repo num; do
  [ -z "$full_repo" ] && continue
  ri=$((ri+1))
  RIDX=$(printf '%03d' "$ri")
  (
    repo_owner="${full_repo%%/*}"
    if ! REQ_REVIEWERS=$(gh api "repos/$full_repo/pulls/$num/requested_reviewers" 2>"$DIRECT_DIR/$RIDX.err"); then
      note_error "requested reviewers ($full_repo#$num)" "$DIRECT_DIR/$RIDX.err"
      REQ_REVIEWERS='{}'
    fi
    # In direct-only repos a team request is not enough: the user must be
    # requested by name.
    MATCH=$(echo "$REQ_REVIEWERS" | jq --arg me "$ME" --arg owner "$repo_owner" --argjson teams "$USER_TEAMS_JSON" \
      --arg repo "$full_repo" --arg direct "$DIRECT_REVIEW_ONLY_REPOS" '
      ($direct | ascii_downcase | split(",") | map(select(length > 0))) as $d
      | ($repo | ascii_downcase) as $r
      | ($d | any(. == $r or . == ($r | split("/") | last))) as $direct_only
      | ((.users // []) | any(.login == $me))
        or (($direct_only | not)
            and ((.teams // []) | any(.slug as $s | $teams | any(.org == $owner and .slug == $s))))
    ')
    if [ "$MATCH" = "true" ]; then
      CI=$(ci_rollup "$full_repo" "$num")
      echo "$REVIEW_RAW" | jq --arg repo "$full_repo" --argjson num "$num" --arg ci "$CI" \
        '.[] | select(.repository.nameWithOwner == $repo and .number == $num) | . + {ci_status: $ci}' \
        > "$DIRECT_DIR/$RIDX.json"
    fi
  ) &
done < <(echo "$REVIEW_RAW" | jq -r '.[] | "\(.repository.nameWithOwner)\t\(.number)"')

MINE_DIR="$TMPDIR/mine_enriched"; mkdir -p "$MINE_DIR"
mi=0
while IFS=$'\t' read -r full_repo num; do
  [ -z "$full_repo" ] && continue
  mi=$((mi+1))
  MIDX=$(printf '%03d' "$mi")
  (
    if ! REVIEWS=$(gh pr view "$num" --repo "$full_repo" --json reviews \
      --jq '[.reviews[] | select(.state != "DISMISSED" and .state != "PENDING") | {author: .author.login, state: .state, at: .submittedAt}] | sort_by(.at) | reverse | unique_by(.author)' 2>"$MINE_DIR/$MIDX.err"); then
      note_error "reviews ($full_repo#$num)" "$MINE_DIR/$MIDX.err"
      REVIEWS="[]"
    fi
    CI=$(ci_rollup "$full_repo" "$num")
    echo "$MY_JSON" | jq --arg repo "$full_repo" --argjson num "$num" --argjson reviews "$REVIEWS" --arg ci "$CI" \
      '.[] | select(.repository.nameWithOwner == $repo and .number == $num) | . + {reviews: $reviews, ci_status: $ci}' \
      > "$MINE_DIR/$MIDX.json"
  ) &
done < <(echo "$MY_JSON" | jq -r '.[] | "\(.repository.nameWithOwner)\t\(.number)"')

TEAM_DIR="$TMPDIR/team_enriched"; mkdir -p "$TEAM_DIR"
ti2=0
while IFS=$'\t' read -r full_repo num; do
  [ -z "$full_repo" ] && continue
  ti2=$((ti2+1))
  TIDX=$(printf '%03d' "$ti2")
  (
    CI=$(ci_rollup "$full_repo" "$num")
    echo "$TEAM_RAW" | jq --arg repo "$full_repo" --argjson num "$num" --arg ci "$CI" \
      '.[] | select(.repository.nameWithOwner == $repo and .number == $num) | . + {ci_status: $ci}' \
      > "$TEAM_DIR/$TIDX.json"
  ) &
done < <(echo "$TEAM_RAW" | jq -r '.[] | "\(.repository.nameWithOwner)\t\(.number)"')

wait
check_errors

# ── Combine phase 2 results ─────────────────────────────
if compgen -G "$DIRECT_DIR/*.json" > /dev/null; then
  REVIEW_JSON=$(cat "$DIRECT_DIR"/*.json | jq -s '.')
else
  REVIEW_JSON="[]"
fi
if compgen -G "$MINE_DIR/*.json" > /dev/null; then
  MY_ENRICHED=$(cat "$MINE_DIR"/*.json | jq -s '.')
else
  MY_ENRICHED="[]"
fi

TEAM_JSON="[]"
if compgen -G "$TEAM_DIR/*.json" > /dev/null; then
  TEAM_JSON=$(cat "$TEAM_DIR"/*.json | jq -s 'sort_by(.createdAt) | reverse')
fi

REVIEW_COUNT=$(echo "$REVIEW_JSON" | jq 'length')
MY_COUNT=$(echo "$MY_ENRICHED" | jq 'length')
TEAM_COUNT=$(echo "$TEAM_JSON" | jq 'length')

# ── JSON output mode ────────────────────────────────────
if [ "$MODE" = "json" ]; then
  jq -n \
    --arg me "$ME" \
    --arg orgs "$ORGS" \
    --argjson review "$REVIEW_JSON" \
    --argjson mine "$MY_ENRICHED" \
    --argjson team "$TEAM_JSON" \
    --argjson review_count "$REVIEW_COUNT" \
    --argjson my_count "$MY_COUNT" \
    --argjson team_count "$TEAM_COUNT" \
    '{
       me: $me,
       orgs: $orgs,
       review: $review,
       mine: $mine,
       team: $team,
       counts: { review: $review_count, mine: $my_count, team: $team_count }
     }'
  exit 0
fi

# ── Render: Review Requests ─────────────────────────────
echo
echo -e "${BOLD}${CYAN}  🔍  WAITING FOR YOUR REVIEW${RESET}"
divider
if [ "$REVIEW_COUNT" -eq 0 ]; then
  echo -e "  ${DIM}All clear — nothing to review ✨${RESET}"
else
  echo "$REVIEW_JSON" | jq -r '.[] | "\(.repository.name)\t#\(.number)\t\(.title)\t\(.author.login)\t\(.createdAt)\t\(.url)\t\(.ci_status // "none")"' | while IFS=$'\t' read -r repo num title author created url ci; do
    printf "  ${CYAN}%-20s${RESET} ${DIM}%s${RESET} %s ${BOLD}%s${RESET}\n" "$repo" "$(link "$url" "$num")" "$(ci_dot "$ci")" "$title"
    printf "  ${DIM}%-20s by %-15s %s${RESET}\n" "" "$author" "$(age_str "$created")"
  done
fi
echo
# ── Render: My Open PRs ─────────────────────────────────
echo -e "${BOLD}${MAGENTA}  🛠️  YOUR OPEN PRs${RESET}"
divider
if [ "$MY_COUNT" -eq 0 ]; then
  echo -e "  ${DIM}No open PRs right now${RESET}"
else
  echo "$MY_ENRICHED" | jq -c '.[]' | while IFS= read -r pr; do
    repo=$(echo "$pr" | jq -r '.repository.name')
    num=$(echo "$pr" | jq -r '.number')
    title=$(echo "$pr" | jq -r '.title')
    url=$(echo "$pr" | jq -r '.url')
    ci=$(echo "$pr" | jq -r '.ci_status // "none"')
    printf "  ${MAGENTA}%-20s${RESET} ${DIM}%s${RESET} %s ${BOLD}%s${RESET}\n" "$repo" "$(link "$url" "#$num")" "$(ci_dot "$ci")" "$title"
    REVIEWS=$(echo "$pr" | jq '.reviews')
    if [ "$(echo "$REVIEWS" | jq 'length')" -eq 0 ]; then
      printf "  ${DIM}%-20s ○ no reviews yet${RESET}\n" ""
    else
      echo "$REVIEWS" | jq -r '.[] | "\(.author)\t\(.state)"' | while IFS=$'\t' read -r reviewer state; do
        printf "  %-20s %s ${DIM}%s${RESET}\n" "" "$(review_icon "$state")" "$reviewer"
      done
    fi
  done
fi
# ── Render: Team PRs ────────────────────────────────────
if [ ${#TEAMMATES[@]} -gt 0 ]; then
  echo
  echo -e "${BOLD}${GREEN}  👥  TEAM${RESET}"
  divider
  if [ "$TEAM_COUNT" -eq 0 ]; then
    echo -e "  ${DIM}No open PRs from teammates${RESET}"
  else
    last_author=""
    echo "$TEAM_JSON" | jq -r '
      group_by(.author.login)
      | map({
          author: .[0].author.login,
          prs: (sort_by(.createdAt) | reverse),
          newest: (map(.createdAt) | max)
        })
      | sort_by(.newest) | reverse
      | .[] | .author as $a | .prs[]
      | "\($a)\t\(.repository.name)\t\(.number)\t\(.title)\t\(.createdAt)\t\(.url)\t\(.ci_status // "none")"
    ' | while IFS=$'\t' read -r author repo num title created url ci; do
      if [ "$author" != "$last_author" ]; then
        [ -n "$last_author" ] && echo
        printf "  ${BOLD}${GREEN}@%s${RESET}\n" "$author"
        last_author="$author"
      fi
      printf "    ${GREEN}%-22s${RESET} ${DIM}%s${RESET} %s ${BOLD}%s${RESET} ${DIM}%s${RESET}\n" "$repo" "$(link "$url" "#$num")" "$(ci_dot "$ci")" "$title" "$(age_str "$created")"
    done
  fi
fi
# ── Summary ──────────────────────────────────────────────
echo
divider
printf "  ${CYAN}%s${RESET} to review  ${MAGENTA}%s${RESET} open PRs" "$REVIEW_COUNT" "$MY_COUNT"
if [ ${#TEAMMATES[@]} -gt 0 ]; then
  printf "  ${GREEN}%s${RESET} team PRs" "$TEAM_COUNT"
fi
echo -e "  ${DIM}@${ME} · ${ORGS}${RESET}"
echo
